{
  "$schema": "https://schemas.tauri.app/2.0.0/capabilities.json",
  "identifier": "default",
  "description": "Default capabilities for the code editor",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "shell:allow-open",
    "dialog:allow-open",
    "dialog:allow-save",
    "dialog:allow-message",
    "dialog:allow-ask",
    "dialog:allow-confirm"
  ]
}
